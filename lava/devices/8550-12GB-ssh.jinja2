{# Device dictionary for the 8550-12GB-ssh LAVA device (device-type: ssh) —
   the 12 GB IMDT 8550 SBC attached to the original Pi, driven remotely by
   worker0 (on ml-machine) over the adb-forwarded ssh port.

   Both boards sit behind the same relay address and are told apart by
   port: 2222 is this 12 GB board, 2223 is the 8 GB one.

   Install on the server with:

     lava-server manage devices add 8550-12GB-ssh --device-type ssh --worker worker0 --tags dut-ssh 8550-12gb
     # then place this file at
     # /etc/lava-server/dispatcher-config/devices/8550-12GB-ssh.jinja2 (owner lavaserver)
#}
{# ssh-keepalive, not stock ssh: adds ServerAlive keepalive to the primary
   connection — see ssh-keepalive.jinja2 for why it has its own name. #}
{% extends 'ssh-keepalive.jinja2' %}
{% set ssh_host = 'DUT-SSH-RELAY-IP' %}
{% set ssh_port = 2222 %}
{% set ssh_user = 'root' %}
{% set ssh_identity_file = '/var/lib/lava/dispatcher/worker/lava-dut-key' %}
