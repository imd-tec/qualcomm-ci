{# Device-type template for ssh DUTs with end-to-end keepalive.

   Install on the server (the device-types volume is rw in the
   lava-server container):

     docker exec -i lava-docker-compose-lava-server-1 sh -c \
       'cat > /etc/lava-server/dispatcher-config/device-types/ssh-keepalive.jinja2' \
       < lava/devices/ssh-keepalive.jinja2

#}
{% extends 'base.jinja2' %}
{% block body %}

actions:
  deploy:
    connections:
      serial:
    methods:
      ssh:
        options:
{{ ssh_options }}
          - '-o'
          - 'ServerAliveInterval=15'
          - '-o'
          - 'ServerAliveCountMax=4'
          - '-o'
          - 'ConnectTimeout=15'
        # primary connections get this from the device dictionary.
        # secondary connections get this from the lava-multinode protocol support.
        host: "{{ ssh_host|default('') }}"
        port: {{ ssh_port|default(22) }}
        user: "{{ ssh_user|default('root') }}"
        identity_file: "{{ ssh_identity_file }}"

  boot:
    connections:
      serial:
    methods:
# can be removed by defining this block empty in the device config
{% block schroot %}
      schroot:
        command:
{{ schroot }}
        name:
          {{ schroot_name_list|default(['unstable', 'sid'])}}
{% endblock schroot %}
      ssh:

{% endblock body %}
